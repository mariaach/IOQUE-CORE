# Django
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
# Mantener False en producción. En local puedes usar True.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.9,.local
# Si Cloudflare/nginx termina TLS y conserva X-Forwarded-Proto=https, deja True.
# Si el origen también atiende HTTP directo (p. ej. una IP sin TLS), usa False.
SECURE_SSL_REDIRECT=True
DJANGO_LANGUAGE_CODE=es
DJANGO_TIMEZONE=America/Mexico_City

# Database
POSTGRES_DB=ioque_catalog
POSTGRES_USER=ioque
POSTGRES_PASSWORD=ioque_secret_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# JWT
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Superuser (creación automática en primer arranque)
# Obligatorio definir una contraseña fuerte; si queda vacía no se crea el usuario.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@ioque.local
DJANGO_SUPERUSER_PASSWORD=

# Cloudflare R2 (Object Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=ioque-media
AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=
AWS_DEFAULT_ACL=public-read
AWS_QUERYSTRING_AUTH=False

# Stripe (Pagos con tarjeta)
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Nequi (Pagos con QR - Colombia, 0% comisión)
# NEQUI_ENABLED=False desactiva el pago con Nequi (el pedido queda PENDING_PAYMENT)
NEQUI_ENABLED=True
# NEQUI_ENVIRONMENT: sandbox | production
NEQUI_ENVIRONMENT=sandbox
# NEQUI_PAYMENT_MODE: static (QR fijo del negocio) | dynamic (QR por transacción vía API)
NEQUI_PAYMENT_MODE=dynamic
# Teléfono Nequi del negocio que recibe el pago (modo dynamic)
NEQUI_MERCHANT_PHONE=3216153977
NEQUI_CLIENT_ID=tu_client_id
NEQUI_CLIENT_SECRET=tu_client_secret
NEQUI_API_KEY=tu_api_key
NEQUI_MERCHANT_CODE=tu_codigo_comercio
NEQUI_AUTH_URI=https://oauth.sandbox.nequi.com/token
NEQUI_API_BASE_PATH=https://api.sandbox.nequi.com/payments/v2
NEQUI_NOTIFICATION_URL=https://tudominio.com/api/payments/nequi-webhook/?token=<NEQUI_WEBHOOK_SECRET>
# Secreto compartido del webhook. Si queda vacío el endpoint responde 503.
# Firma HMAC-SHA256 del cuerpo en X-Nequi-Signature (hex o sha256=<hex>)
# o usa ?token=<secreto> en la URL de notificación.
NEQUI_WEBHOOK_SECRET=
# QR estático (mode=static): URL de la imagen QR del negocio
NEQUI_STATIC_QR_URL=https://tudominio.com/media/qr-nequi.png
NEQUI_BUSINESS_NAME=IO QUE Artesanías
NEQUI_PAYMENT_EXPIRATION_MINUTES=15

# Envío
# Envío incluido en el precio del producto (sin cobro adicional)
DEFAULT_SHIPPING_COST=0
# Si la cantidad total de productos supera este umbral, se descuenta
# SHIPPING_DISCOUNT_PER_EXTRA del total por cada producto adicional.
SHIPPING_DISCOUNT_THRESHOLD=2
SHIPPING_DISCOUNT_PER_EXTRA=15000
